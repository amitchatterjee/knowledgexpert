{
    "promptDir": "${HOME}/.knowledgexpert/conf/wolfpack/tester",

    "llmModel": "gpt-5.4",
    "llmApiEndpoint": "https://api.openai.com/v1",

    "skipMcpTools": true,
    "retrievalType": "2stepRag",
    "embeddings": [
        {
            "embeddingId": "code",
            "embeddingApiUrl": "https://api.openai.com/v1/embeddings|${EMBEDDING_MODEL_CODE}",
            "embeddingModel": "${EMBEDDING_MODEL_CODE}",
            "embeddingProvider": "openai"
        },
        {
            "embeddingId": "doc",
            "embeddingApiUrl": "http://localhost:11434",
            "embeddingModel": "${EMBEDDING_MODEL_DATA}",
            "embeddingProvider": "ollama"
        }
    ],

    "vectorDbProvider": "${VECTOR_DB_PROVIDER}",
    "vectorDbHost": "${VECTOR_DB_HOST}",
    "vectorDbPort": "${VECTOR_DB_PORT}",
    "vectorDbUseSsl": "${VECTOR_DB_USE_SSL}",
    "vectorDbUsername": "${VECTOR_DB_READ_USERNAME}",
    "vectorDbPassword": "${VECTOR_DB_READ_PASSWORD}",
    "vectorDbIndexPrefix": "${VECTOR_DB_INDEX_PREFIX}",
    "baseCollections": [
        {
            "collectionName": "app_docs_collection",
            "searchAlgorithm": "similarity",
            "embeddingId": "doc"
        }],
    "ensembleWeights": [1],
    "contextPaths": []
}
