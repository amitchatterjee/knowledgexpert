{
    "promptDir": "${HOME}/.knowledgexpert/conf/wolfpack/analyst",

    "llmModel": "anthropic:claude-sonnet-4-20250514",
    "llmApiEndpoint": "https://api.anthropic.com",

    "embeddings": [
        {
            "embeddingId": "code",
            "embeddingApiUrl": "https://api.openai.com/v1/embeddings|${EMBEDDING_MODEL_CODE}",
            "embeddingModel": "${EMBEDDING_MODEL_CODE}",
            "embeddingProvider": "openai"
        },
        {
            "embeddingId": "doc",
            "embeddingApiUrl": "http://localhost:9000",
            "embeddingModel": "${EMBEDDING_MODEL_DATA}",
            "embeddingProvider": "huggingface"
        }
    ],

    "chromaHost": "localhost",
    "chromaPort": 8000,
    "baseCollections": [
        {
            "collectionName": "rules_collection",
            "searchAlgorithm": "similarity",
            "k": 3,
            "embeddingId": "code"
        },
        {
            "collectionName": "app_docs_collection",
            "searchAlgorithm": "mmr",
            "k": 5,
            "embeddingId": "doc"
        },
        {
            "collectionName": "framework_docs_collection",
            "searchAlgorithm": "mmr",
            "k": 3,
            "embeddingId": "doc"
        }],
    "ensembleWeights": [0.1, 0.8, 0.1],

    "format": "structured",

    "contextPaths": [],
    
    "useGraphRag": false,

    "verbose": false,
    "disableHistory": true
}
