{
    "promptDir": "${HOME}/.knowledgexpert/conf/wolfpack/analyst",
    "llmModel": "gpt-5.4",
    "llmApiEndpoint": "https://api.openai.com/v1",
    "skipMcpTools": true,
    "retrievalType": "agenticRag",
    "embeddings": [
        {
            "embeddingId": "code",
            "embeddingApiUrl": "https://api.openai.com/v1/embeddings|${EMBEDDING_MODEL_CODE}",
            "embeddingModel": "${EMBEDDING_MODEL_CODE}",
            "embeddingProvider": "openai"
        },
        {
            "embeddingId": "doc",
            "embeddingApiUrl": "http://localhost:11434",
            "embeddingModel": "${EMBEDDING_MODEL_DATA}",
            "embeddingProvider": "ollama"
        }
    ],
    "vectorDbProvider": "${VECTOR_DB_PROVIDER}",
    "vectorDbHost": "${VECTOR_DB_HOST}",
    "vectorDbPort": "${VECTOR_DB_PORT}",
    "vectorDbUseSsl": "${VECTOR_DB_USE_SSL}",
    "vectorDbUsername": "${VECTOR_DB_READ_USERNAME}",
    "vectorDbPassword": "${VECTOR_DB_READ_PASSWORD}",
    "vectorDbIndexPrefix": "${VECTOR_DB_INDEX_PREFIX}",
    "baseCollections": [
        {
            "collectionName": "rules_collection",
            "searchAlgorithm": "similarity",
            "k": 3,
            "embeddingId": "code"
        },
        {
            "collectionName": "app_docs_collection",
            "searchAlgorithm": "mmr",
            "k": 5,
            "embeddingId": "doc"
        },
        {
            "collectionName": "framework_docs_collection",
            "searchAlgorithm": "mmr",
            "k": 3,
            "embeddingId": "doc"
        }
    ],
    "ensembleWeights": [
        0.05,
        0.75,
        0.2
    ],
    "vectorToolName": "RulesInformationVectorDb",
    "vectorToolDescription": "A vector database that contains documentation for the Knowledgenet rules engine and auto insurance rules application. It includes documentation and code snippets about fundamental concepts of the rules engine and rules for adjudicating auto insurance claims. It also contains code snippets of the data structures and rules. In addition, it contains information on the unit testing tool for testing rules.",

    "contextPaths": []
}