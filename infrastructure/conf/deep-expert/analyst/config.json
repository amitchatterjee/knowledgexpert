{
    "promptDir": "${HOME}/.knowledgexpert/conf/deep-expert/analyst",

    "llmModel": "anthropic:claude-sonnet-4-20250514",
    "llmApiEndpoint": "https://api.anthropic.com",

    "embeddingApiUrl": "http://localhost:9000",
    "embeddingModel": "${EMBEDDING_MODEL_DATA}",
    "embeddings": [
        "code|openai|https://api.openai.com/v1/embeddings|${EMBEDDING_MODEL_CODE}", 
        "doc|huggingface|http://localhost:9000|${EMBEDDING_MODEL_DATA}"],

    "chromaHost": "localhost",
    "chromaPort": 8000,
    "baseCollections": [
        {
            "collectionName": "rules_collection",
            "searchAlgorithm": "similarity",
            "k": 3,
            "embeddingId": "code"
        },
        {
            "collectionName": "app_docs_collection",
            "searchAlgorithm": "mmr",
            "k": 5,
            "embeddingId": "doc"
        },
        {
            "collectionName": "framework_docs_collection",
            "searchAlgorithm": "mmr",
            "k": 3,
            "embeddingId": "doc"
        }],
    "ensembleWeights": [0.1, 0.8, 0.1],

    "format": "structured",

    "contextPaths": [],
    
    "useGraphRag": false,

    "verbose": false,
    "disableHistory": true
}
