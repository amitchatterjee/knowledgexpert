{
    "promptDir": "${HOME}/.knowledgexpert/conf/deep-expert/analyst",

    "llmModel": "anthropic:claude-sonnet-4-20250514",
    "llmApiEndpoint": "https://api.anthropic.com",

    "embeddingApiUrl": "http://localhost:9000",
    "embeddingModel": "${EMBEDDING_MODEL}",
    
    "chromaHost": "localhost",
    "chromaPort": 8000,
    "baseCollections": ["rules_collection:similarity:3", "app_docs_collection:mmr:10", "framework_docs_collection:mmr:3"],
    "ensembleWeights": [0.1, 0.8, 0.1],
    "searchAlgorithm": "similarity",

    "format": "structured",

    "contextPaths": [],
    
    "useGraphRag": false,

    "verbose": false,
    "disableHistory": true
}
