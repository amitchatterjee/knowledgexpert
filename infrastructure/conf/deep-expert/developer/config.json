{
    "promptDir": "${HOME}/.knowledgexpert/conf/deep-expert/developer",

    "llmModel": "openai:llama-4-scout-17b-16e-instruct",
    "llmApiEndpoint": "https://api.lambda.ai/v1",

    "embeddingApiUrl": "http://localhost:8080",
    "embeddingModel": "msmarco-MiniLM-L-6-v3",
    
    "chromaHost": "localhost",
    "chromaPort": 8000,
    "baseCollection": "rules_collection",

    "format": "structured",
    "contextPaths": [],
    
    "useGraphRag": true,
    "neo4jUri": "bolt://localhost:7687",
    "neo4jUser": "neo4j",
    "neo4jPassword": "password",

    "graphLlmModel": "openai:llama-4-scout-17b-16e-instruct",
    "graphLlmApiEndpoint": "https://api.lambda.ai/v1",

    "searchAlgorithm": "mmr",
    "scoreThreshold": 0.9,

    "ensembleWeights": [0.5, 0.5],

    "verbose": true,
    "log": "INFO"
}
