{
    "promptDir": "${HOME}/.knowledgexpert/conf/deep-expert/developer",

    "llmModel": "openai:llama-4-scout-17b-16e-instruct",
    "llmApiEndpoint": "https://api.lambda.ai/v1",

    "embeddingApiUrl": "http://localhost:9000",
    "embeddingModel": "${EMBEDDING_MODEL}",
    
    "chromaHost": "localhost",
    "chromaPort": 8000,
    "baseCollections": ["all_collection"],

    "format": "structured",
    "contextPaths": [],
    
    "useGraphRag": false,
    "neo4jUri": "bolt://localhost:7687",
    "neo4jUser": "neo4j",
    "neo4jPassword": "password",

    "graphLlmModel": "anthropic:claude-sonnet-4-20250514",
    "graphLlmApiEndpoint": "https://api.anthropic.com",

    "k": 50,
    "ensembleWeights": [0.5, 0.5],

    "verbose": true,
    "disableHistory": true
}
