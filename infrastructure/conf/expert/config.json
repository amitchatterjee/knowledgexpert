{
    "promptDir": "${HOME}/.knowledgexpert/conf/expert",

    "llmModel": "gpt-5.4",
    "llmApiEndpoint": "https://api.openai.com/v1",
    
    "embeddings": [
        {
            "embeddingId": "all",
            "embeddingApiUrl": "http://localhost:11434",
            "embeddingModel": "${EMBEDDING_MODEL_DATA}",
            "embeddingProvider": "ollama"
        }],

    "vectorDbProvider": "${VECTOR_DB_PROVIDER}",
    "vectorDbHost": "${VECTOR_DB_HOST}",
    "vectorDbPort": "${VECTOR_DB_PORT}",
    "vectorDbUseSsl": "${VECTOR_DB_USE_SSL}",
    "vectorDbUsername": "${VECTOR_DB_READ_USERNAME}",
    "vectorDbPassword": "${VECTOR_DB_READ_PASSWORD}",
    "vectorDbIndexPrefix": "${VECTOR_DB_INDEX_PREFIX}",
    "baseCollections": [{"collectionName": "all_collection", 
                        "embeddingId": "all",
                        "searchAlgorithm": "mmr"}],

    "format": "raw",
    
    "useGraphRag": true,
    "neo4jUri": "bolt://localhost:7687",
    "neo4jUser": "neo4j",
    "neo4jPassword": "password",

    "graphLlmModel": "anthropic:claude-sonnet-4-20250514",
    "graphLlmApiEndpoint": "https://api.anthropic.com",

    "contextPaths": [],
    "ensembleWeights": [1.0],

    "verbose": true,
    "log": "INFO"
}
