{
    "promptDir": "${HOME}/.knowledgexpert/conf/wolfpack-legacy/developer",

    "llmModel": "gpt-5.4",
    "llmApiEndpoint": "https://api.openai.com/v1",

    "embeddings": [
        {
            "embeddingId": "code",
            "embeddingApiUrl": "https://api.openai.com/v1/embeddings|${EMBEDDING_MODEL_CODE}",
            "embeddingModel": "${EMBEDDING_MODEL_CODE}",
            "embeddingProvider": "openai"
        },
        {
            "embeddingId": "doc",
            "embeddingApiUrl": "http://localhost:11434",
            "embeddingModel": "${EMBEDDING_MODEL_DATA}",
            "embeddingProvider": "ollama"
        }
    ],

    "vectorDbProvider": "chroma",
    "vectorDbHost": "localhost",
    "vectorDbPort": 8000,
    "vectorDbUseSsl": false,
    "vectorDbUsername": null,
    "vectorDbPassword": null,
    "vectorDbIndexPrefix": null,
    "baseCollections": [
        {
            "collectionName": "app_platform_collection",
            "searchAlgorithm": "similarity",
            "embeddingId": "code"
        },
        {
            "collectionName": "rules_collection",
            "searchAlgorithm": "similarity",
            "embeddingId": "code"
        }],
    "ensembleWeights": [0.25, 0.75],

    "format": "structured",
    "contextPaths": [],
    
    "useGraphRag": false,
    "neo4jUri": "bolt://localhost:7687",
    "neo4jUser": "neo4j",
    "neo4jPassword": "password",

    "graphLlmModel": "anthropic:claude-sonnet-4-20250514",
    "graphLlmApiEndpoint": "https://api.anthropic.com",

    "verbose": false,
    "disableHistory": true
}
