# Which target application's rule-generation content to use -- a local path (bare, or file://) or
# an s3://<bucket>/<prefix> URI. knowledge/, prompts/, and mcp/ are derived as fixed subpaths
# beneath it. No default: this is "which target application," so it must be set explicitly.
RULEGEN_ROOT=../knowledgenet-examples/autoins-rulegen

# Only read when RULEGEN_ROOT above uses the s3:// scheme.
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
